[Unit]
Description=Token Talk Codex agent broker (Unix socket only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=token-talk-codex
Group=token-talk-bridge
Environment=HOME=/home/token-talk-codex
Environment=CODEX_HOME=/var/lib/token-talk-codex/codex-home
Environment=PATH=/opt/token-talk/codex-broker/bin:/home/token-talk-codex/.local/node22/bin:/home/token-talk-codex/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/token-talk/codex-broker.env
Environment=TOKEN_TALK_CODEX_SOCKET_PATH=/run/token-talk-codex/worker.sock
Environment=TOKEN_TALK_CODEX_WORKSPACE_ROOT=/var/lib/token-talk-codex/workspace
Environment=TOKEN_TALK_CODEX_EFFORT=max
Environment=TOKEN_TALK_CODEX_AUDIT_EFFORT=max
Environment=TOKEN_TALK_CODEX_TIMEOUT_MS=285000
ExecStart=/opt/token-talk/codex-broker/bin/node /opt/token-talk/codex-broker/current/dist/main.js
RuntimeDirectory=token-talk-codex
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0007
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/token-talk-codex /run/token-talk-codex

[Install]
WantedBy=multi-user.target
