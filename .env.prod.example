# ICP 可访问性就绪前使用带临时自签名证书的 ECS 公网 IP；最终再切换正式 HTTPS 子域名。
TOKEN_TALK_PUBLIC_ORIGIN=https://182.92.85.15
TOKEN_TALK_HOST_PORT=4321
# Token Talk 使用独立子域名根路径。
TOKEN_TALK_BASE_PATH=/

# Wikimedia 要求可识别的 User-Agent；请写项目 URL 或联系邮箱。
TOKEN_TALK_RESEARCH_USER_AGENT=TokenTalk/0.1 (https://talk.wangjinkun333.me; contact@example.com)
TOKEN_TALK_RESEARCH_CONTACT_EMAIL=contact@example.com

# 部署脚本会从宿主机 token-talk-bridge 组自动覆盖这个占位值。
TOKEN_TALK_CODEX_SOCKET_GID=22012
TOKEN_TALK_CODEX_RUNTIME_DIR=/run/token-talk-codex
TOKEN_TALK_CODEX_MODEL=

# 仅在真正需要付费 TTS 时配置。免费研究、热点和 Codex 订阅链路不依赖它们。
ELEVENLABS_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# 免费自托管热点源，默认固定到已调研版本；升级应单独验证后修改。
NEWSNOW_IMAGE=ghcr.io/ourongxing/newsnow@sha256:98b62bd971d308040937fdfde5263a00715b357894936e88b3ce3c0d8adbf55a
DAILYHOT_IMAGE=imsyy/dailyhot-api@sha256:748fc79d29a422f512018e8a58ef1a0e20306dd6254637933960573fa37b1e5e
NEWSNOW_JWT_SECRET=replace-with-a-random-server-only-value

TOKEN_TALK_BUILD_NODE_IMAGE=node:22-alpine
# 阿里云 ECS 使用内网 Alpine 源；GitHub CI 会覆盖为公共 ECR 基础镜像并保留官方 apk 源。
ALPINE_MIRROR=http://mirrors.cloud.aliyuncs.com/alpine
